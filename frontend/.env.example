# Backend API base URL (no trailing slash). The app prefixes every /v1/... call
# and every backend-relative asset path (e.g. self-hosted demo GIFs) with this.
#
# Local dev, backend running via run.ps1:
VITE_API_URL=http://127.0.0.1:5057

# Production, once deployed:
# VITE_API_URL=https://your-backend.up.railway.app

# Optional: send the chatbot's calls (/v1/rehab/*) to a SEPARATE backend
# instance, so a slow AI reply can never make login/dashboard/logging wait
# behind it (see app/platform/config.py's `service_role`). Only meaningful
# once a second Railway service actually exists, deployed from this same
# repo with SERVICE_ROLE=chat, while the original service is set to
# SERVICE_ROLE=web. Leave unset to keep everything on one backend, exactly
# as today.
# VITE_CHAT_API_URL=https://your-backend-chat.up.railway.app
