# The live clinic database: copy DATABASE_URL from dataanalysis/.env.
# This app only reads it (every connection is read-only).
CLINIC_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# The agent's model, via OpenRouter
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

# Temporary store for the agent's own data (cases, plan drafts, plans). Read and write.
TEMP_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres
