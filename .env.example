## Required in production (the app refuses to boot without these) ##########

FLASK_ENV=development
SECRET_KEY=change-me-to-at-least-32-characters-long
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fitness
# Two SEPARATE Redis instances/databases — must not be the same value, the
# app refuses to boot if they match (one holds revoked tokens/rate limits and
# must never be evictable; the other is a disposable cache).
REDIS_DURABLE_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
JWT_CURRENT_KID=dev-1
JWT_KEY_CURRENT=dev-jwt-signing-key-not-for-production


## Optional, but worth setting deliberately on a real deploy ###############

# Enables key rotation without forcing every logged-in user out (1.3) — set
# BOTH or neither; a JWT signing key you want to retire moves here, the new
# one becomes JWT_CURRENT_KID/JWT_KEY_CURRENT above.
# JWT_PREVIOUS_KID=
# JWT_KEY_PREVIOUS=

# Module 5 (the rehab/pain AI chatbot) — a SEPARATE Postgres (Supabase +
# pgvector) from DATABASE_URL above, by design, so the vector store can't
# affect the primary datastore. If either is unset, Module 5 just returns a
# config error to the user instead of refusing to boot the whole app.
RAG_DATABASE_URL=
OPENROUTER_API_KEY=

# RLM progression engine feature flags — independent on/off switches so
# either half can be disabled without a code change if something needs
# investigating. Default true (both on) if unset.
RLM_WEEKLY_PROGRESSION_ENABLED=true
RLM_CHAT_ANALYSIS_ENABLED=true

# Token lifetimes. Defaults shown are what the app uses if these are unset —
# only set them if you deliberately want something different.
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_ABSOLUTE_CAP_DAYS=180
REFRESH_GRACE_SECONDS=30

# Password/lockout policy. Defaults shown.
PASSWORD_MIN_LENGTH=10
BREACH_CHECK_ENABLED=true
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_BASE_SECONDS=30

# Rate limits — three independent ceilings (2.3). Defaults shown.
RL_USER_PER_MINUTE=120
RL_DEVICE_PER_HOUR=60
RL_IP_PER_HOUR=200

# Shown to a client that asks whether it needs to update — not read via
# app/platform/config.py, read directly at request time in app/factory.py.
# Defaults shown.
MIN_APP_VERSION=1.0.0
SOFT_UPDATE_VERSION=1.0.0

# devconsole (app/devconsole/) — an internal developer testing tool, never
# mounted at all when FLASK_ENV=production. Requires its OWN auth,
# independent of FLASK_ENV — a blank password makes devconsole refuse every
# request outright (fail closed), even outside production. Only relevant for
# non-production environments; irrelevant on a real production deploy.
DEVCONSOLE_USER=admin
DEVCONSOLE_PASSWORD=change-me
