# Copy to backend/.env (gitignored) and fill in.

# Database: Supabase dashboard -> Connect -> Session pooler connection string,
# starting postgresql+psycopg:// . Unset = a local SQLite file.
# DATABASE_URL=

# Supabase Auth (Project Settings -> API Keys / Data API)
SUPABASE_URL=
# Admin key, ONLY for scripts/create_doctor.py. Never put it in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Only if your project still uses the legacy JWT secret (Project Settings -> JWT Keys).
# Leave blank for projects on the newer signing keys.
# SUPABASE_JWT_SECRET=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini

CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
